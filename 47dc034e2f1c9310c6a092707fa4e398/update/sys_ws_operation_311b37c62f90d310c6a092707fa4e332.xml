        <http_method>GET</http_method>
        <name>GetEmployees</name>
        <operation_script><![CDATA[
(function process(request, response) {

    var query = request.queryParams.query || '';

    var users = [];
    var gr = new GlideRecordSecure('sys_user');

    // Return only active employees
    gr.addQuery('active', true);

    // Search by employee name
    if (query) {
        gr.addQuery('name', 'CONTAINS', query);
    }

    gr.orderBy('name');
    gr.setLimit(100);
    gr.query();

    while (gr.next()) {

        users.push({
            user_sys_id: gr.getUniqueValue(),
            name: gr.getValue('name')
        });

    }

    response.setStatus(200);

    response.setBody({
        result: {
            success: true,
            data: {
                users: users
            }
        }
    });

})(request, response);
]]></operation_script>
